# Copy to .env.local and fill in. Never commit .env.local.
# Everything here has a FREE option. The defaults below cost nothing.

# --- App ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (FREE: local via Docker, or free cloud project) -----------
# `npx supabase start` prints these (API URL, anon key, service_role key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI: Google Gemini (FREE tier, key from https://aistudio.google.com/apikey) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
# First model your key can use wins. Check names/limits at https://aistudio.google.com/rate-limit
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash
# Free tier is ~15 requests/min: keep parallelism low.
PIPELINE_CONCURRENCY=3
CLASSIFY_CONCURRENCY=2
# Optional paid alternative: AI_PROVIDER=anthropic + ANTHROPIC_API_KEY (+ ANTHROPIC_MODEL)
ANTHROPIC_API_KEY=

# --- Inngest (FREE: local dev server) ------------------------------------
# Local: run `npm run inngest` and keep INNGEST_DEV=1.
# Vercel: remove INNGEST_DEV and set both keys (Inngest free plan / Vercel integration).
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- WhatsApp ------------------------------------------------------------
# log      = FREE, sends nothing, message is saved + shown in the portal (default)
# meta     = FREE Meta WhatsApp Cloud API test number (up to 5 verified recipients)
# telegram = FREE Telegram bot (all messages go to TELEGRAM_CHAT_ID)
# twilio   = Twilio sandbox (trial account)
WHATSAPP_PROVIDER=log
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v21.0
# Optional: send an approved template (e.g. hello_world) instead of free text when outside the 24h window
META_WA_TEMPLATE=
META_WA_TEMPLATE_LANG=en_US
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Email ---------------------------------------------------------------
# log    = FREE, sends nothing (default)
# smtp   = FREE with Gmail: smtp.gmail.com / 465 / your gmail / 16-char App Password
# resend = FREE tier (3,000/month)
EMAIL_PROVIDER=log
EMAIL_FROM="Claims Desk <you@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# --- Optional ------------------------------------------------------------
# Shared secret for the Supabase Database Webhook -> /api/webhooks/query-letter
SUPABASE_WEBHOOK_SECRET=
# 1 = run the UI on seed fixtures with no backend (read-only review mode). Never set in production.
NEXT_PUBLIC_DEMO_MODE=0
